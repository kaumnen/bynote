{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byline",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "CASES",
        "class_name": "CaseRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaseRoom"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}